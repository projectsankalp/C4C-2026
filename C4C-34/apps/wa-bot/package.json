{
  "name": "@hastkala/wa-bot",
  "version": "0.1.0",
  "private": true,
  "description": "BolKeBecho — HastKala WhatsApp bot. Converts artisan WhatsApp messages into product drafts.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:supervised": "ts-node --transpile-only src/supervisor.ts",
    "dev:simulator": "ts-node-dev --respawn --transpile-only src/simulator/server.ts",
    "dev:mock-backend": "ts-node-dev --respawn --transpile-only src/mock-backend/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:simulator": "node dist/simulator/server.js",
    "start:mock-backend": "node dist/mock-backend/server.js",
    "typecheck": "tsc --noEmit",
    "setup": "ts-node-dev --transpile-only scripts/setup.ts",
    "test:unit": "node --require ts-node/register --test \"tests/*.test.ts\"",
    "test:flow": "ts-node-dev --transpile-only scripts/test-flow.ts",
    "test:e2e": "ts-node-dev --transpile-only scripts/test-end-to-end.ts",
    "test:integration": "ts-node-dev --transpile-only scripts/test-integration.ts",
    "test:integration:batch": "ts-node-dev --transpile-only scripts/test-integration-batch.ts",
    "test:whisper": "ts-node-dev --transpile-only scripts/test-whisper.ts"
  },
  "keywords": [
    "hastkala",
    "whatsapp",
    "artisan",
    "commerce"
  ],
  "author": "HastKala Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "form-data": "^4.0.5",
    "openai": "^4.95.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^10.0.0",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
