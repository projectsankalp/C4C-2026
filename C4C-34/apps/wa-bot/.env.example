# =====================================================
# HastKala BolKeBecho WhatsApp Bot
# Copy this file to .env and fill in values for local dev.
# =====================================================

# --- Bot identity ---
BOT_NAME=HastKala BolKeBecho
SESSION_ID=HASTKALA_DEMO

# --- Backend integration ---
# Person 4 backend (Express + Prisma) — default port 5000
BACKEND_URL=http://localhost:5000
# Where Person 1 hosts the public marketplace (used to format approved-product links sent to artisan)
PUBLIC_WEB_URL=http://localhost:3000
# Where Person 2 hosts the vendor dashboard (used to format approval-link sent to coordinator)
VENDOR_WEB_URL=http://localhost:3001

# --- Internal HTTP server (used by backend to trigger order alerts) ---
PORT=5001
# Must match WHATSAPP_BOT_SECRET in apps/api/.env so backend → bot calls authenticate.
WHATSAPP_BOT_SECRET=wa-demo-secret

# --- Simulator (browser fallback if Open-WA breaks during demo) ---
SIMULATOR_PORT=5002

# --- Mock backend (lets us develop without waiting on Person 4) ---
MOCK_BACKEND_PORT=4000

# --- Demo safety controls ---
# When true, only ALLOWED_TEST_NUMBERS receive replies. Always keep true for hackathon demo.
DEMO_MODE=true
# Comma-separated. Use the digits of the phone numbers (no +, no spaces).
# Replace these placeholders before running. Use a teammate phone or a personal demo phone.
ALLOWED_TEST_NUMBERS=919876543210,919999999999

# --- Open-WA tuning ---
# Set HEADLESS=false the first time you run the bot, scan the QR with the demo number, then flip to true.
HEADLESS=true

# --- Mock-mode toggle ---
# If true, the bot will not call the real backend. It will fabricate a draft response for offline rehearsal.
USE_MOCK_DRAFT=false

# --- OpenAI ---
# Optional. When set, voice notes are transcribed by Whisper instead of the mock.
# Get a key at https://platform.openai.com/api-keys
# DO NOT commit this file. .env is gitignored.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_EXTRACTION_MODEL=gpt-5-mini

# --- Text-to-Speech (every bot reply gets a voice note) ---
# Disable by setting BOT_TTS_ENABLED=false.
BOT_TTS_ENABLED=true
# OpenAI TTS model. gpt-4o-mini-tts is much better at Indic languages than tts-1.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Voice character. Options: alloy, echo, fable, onyx, nova, shimmer, coral, sage, ash, ballad.
OPENAI_TTS_VOICE=nova
# Replies longer than this skip TTS to avoid runaway latency / payload size.
BOT_TTS_MAX_CHARS=600

# --- GPT Audio model (used for Tamil + Malayalam translation + voice in one call) ---
# This is OpenAI's multimodal audio model that translates AND speaks in one
# Chat Completions call with native Indic-language accents. Used when the
# user picks Tamil or Malayalam (no hand-translated message pack exists for
# those yet). Falls back to the TTS model above if this fails.
OPENAI_AUDIO_MODEL=gpt-4o-mini-audio-preview
OPENAI_AUDIO_VOICE=shimmer

# Tutorial video sent during first-time onboarding.
# Use a hostable mp4/youtu.be URL. Whatsapp-web.js will send as a link;
# WhatsApp shows a preview tile.
TUTORIAL_VIDEO_URL=https://hastkala.example.com/tutorial.mp4
