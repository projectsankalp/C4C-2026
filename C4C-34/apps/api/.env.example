# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_PUBLIC_WEB_URL=http://localhost:3000
CLIENT_VENDOR_WEB_URL=http://localhost:3001
API_BASE_URL=http://localhost:5000
PUBLIC_APP_BASE_URL=http://localhost:3000

# Database (Supabase PostgreSQL)
# Use the Supabase database password locally; never commit real credentials.
DATABASE_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.zbjxkiqqxdsybnrzjkpv.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_DATABASE_PASSWORD@db.zbjxkiqqxdsybnrzjkpv.supabase.co:5432/postgres"
USE_MEMORY_STORE=false

# Demo security
DEMO_API_KEY=hastkala-demo-key

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# OpenAI (AI Listing Generator)
# Set AI_PROVIDER=openai to call gpt-5-mini for product listing generation.
# Set AI_PROVIDER=mock to skip the LLM and use the deterministic rule-based fallback.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_key
OPENAI_LISTING_MODEL=gpt-5-mini
GEMINI_API_KEY=

# WhatsApp Bot Callback
WHATSAPP_BOT_URL=http://localhost:3003
WA_BOT_URL=http://localhost:5001
WHATSAPP_BOT_SECRET=wa-demo-secret

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# JWT Secret (for future auth)
JWT_SECRET=your_jwt_secret_change_in_production
