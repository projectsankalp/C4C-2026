# ─────────────────────────────────────────────────────────────────────────────
# HaathSe Frontend — Environment Configuration
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── FastAPI Backend URL ───────────────────────────────────────────────────────
# For local dev: leave as-is (http://localhost:8000)
# For deployed backend: set to your server URL
VITE_API_URL=http://localhost:8000

# ── Supabase JS (frontend direct access) ─────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
# These are the SAME project credentials as the backend .env, different prefix.
# VITE_SUPABASE_URL: your project URL (safe to expose — Supabase uses RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY: your public anon key (safe for browser use)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────
# When VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are not set:
#   - Product reads fall back to FastAPI proxy (/api/products)
#   - Supabase Realtime subscription is disabled
#   - All other features (upload, AI pipeline, demo mode) work normally
# ─────────────────────────────────────────────────────────────────────────────
