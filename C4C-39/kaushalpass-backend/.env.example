# KaushalPass Backend — shared env template (Person 1 + Person 2)

# --- Person 1 (app bootstrap, voice, Redis, Sarvam) ---
APP_NAME=KaushalPass API
APP_VERSION=1.0
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (Dashboard → Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_JWKS_URL=

# Redis — Upstash redis:// URL, or "memory" for local dev (no Redis server)
REDIS_URL=memory

# Sarvam AI — https://dashboard.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key

# NVIDIA NIM — https://build.nvidia.com (Person 1 GLM + Person 2 Nemotron)
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
GLM_MODEL=z-ai/glm-5.1

# Storage bucket (create in Supabase Storage, public or signed)
TTS_BUCKET=tts-audio
TTS_SIGNED_URL_EXPIRY_SECONDS=3600

VOICE_ASSESS_DAILY_LIMIT=10

# --- Person 2 (passport, documents, certificates) ---
# QR links on generated PDF certificates
APP_URL=https://kaushalpass.in

STORAGE_BUCKET_DOCUMENTS=documents
STORAGE_BUCKET_CERTIFICATES=certificates
PASSPORT_CODE_PREFIX=KP-2025

# --- Scheme Advisor (Groq AI matcher) ---
GROQ_API_KEY=your-groq-api-key
